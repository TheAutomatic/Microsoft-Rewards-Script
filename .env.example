# Copy to .env (DO NOT commit .env)
# Telegram notifications for scripts/run_with_notify.sh
TG_BOT_TOKEN="PASTE_YOUR_BOT_TOKEN_HERE"
TG_CHAT_ID="PASTE_YOUR_CHAT_ID_HERE"

# Optional: pushplus
# PUSHPLUS_TOKEN=""

# Notification policies (optional)
# - all (default): send all notifications
# - none: send nothing
# - approval_only: only send when Authenticator requires selecting a number
# - end_only: only send end notifications
# - alert_only: only send end notifications when something looks wrong
# NOTIFY_TG=all
# NOTIFY_PUSHPLUS=all
